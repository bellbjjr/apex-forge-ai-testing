{
  "name": "Apex Forge Selenium",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [
    7900
  ],
  "portsAttributes": {
    "7900": {
      "label": "Live Selenium browser",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postStartCommand": "bash scripts/start-browser.sh",
  "remoteEnv": {
    "DISPLAY": ":99"
  }
}
